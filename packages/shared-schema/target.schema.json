{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aegis-mesh/schemas/target.schema.json",
  "title": "Target",
  "description": "A target injected for authorized security testing. Mirrors services/api/src/api/models.py::Target.",
  "type": "object",
  "required": ["id", "name", "base_url", "authorization_note", "status", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "base_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "authorization_note": {
      "type": "string",
      "minLength": 10,
      "description": "Program name, ticket link, or ownership statement. Required, recorded for audit, not independently verified."
    },
    "status": { "type": "string", "enum": ["active", "paused", "archived"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
