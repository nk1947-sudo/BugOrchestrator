{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bugorchestrator/schemas/finding.schema.json",
  "title": "Finding",
  "description": "A confirmed or unconfirmed result from the VERIFY stage. Mirrors services/api/src/api/models.py::Finding.",
  "type": "object",
  "required": ["id", "scan_id", "target_id", "title", "category", "severity", "status", "summary", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "scan_id": { "type": "string", "format": "uuid" },
    "target_id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "category": {
      "type": "string",
      "enum": ["idor", "broken_access_control", "business_logic", "sqli", "ssrf", "xss", "other"]
    },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
    "cvss_score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
    "status": { "type": "string", "enum": ["confirmed", "unconfirmed", "false_positive"] },
    "summary": { "type": "string" },
    "evidence_path": {
      "type": ["string", "null"],
      "description": "Path to the local Markdown report under workspace/findings/, written by orchestrator/reporting.py."
    },
    "raw_request": { "type": ["string", "null"] },
    "raw_response": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
