# ==============================================================================
# BugOrchestrator - Environment Configuration Template
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# NEVER commit `.env` - it is already covered by .gitignore.
# Every secret below is optional at the connector level: if a key is left
# blank, that connector reports itself unconfigured and is skipped rather
# than silently failing mid-scan.
# ==============================================================================

# ---- Core ----
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
# Random 64-char string used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- Database (services/api) ----
# POSTGRES_HOST/PORT/DATABASE_URL below are for HOST-SIDE tools only (running
# alembic or the API directly on your machine, outside Docker). Containers
# never read these - docker-compose.yml hardcodes DATABASE_URL to the
# internal postgres:5432 network alias for the api/orchestrator services.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bugorchestrator
POSTGRES_USER=bugorchestrator
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://bugorchestrator:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Host port the postgres container's 5432 is published on (docker-compose.yml).
# Defaults to 5433 to avoid colliding with a locally installed Postgres.
POSTGRES_HOST_PORT=5433
# Host port the dashboard container's 3000 is published on.
DASHBOARD_HOST_PORT=3000

# ---- Redis (rate-limit / cooldown state, pub-sub for live updates) ----
REDIS_URL=redis://redis:6379/0

# ---- API service (control plane) ----
API_HOST=0.0.0.0
API_PORT=8000
API_INTERNAL_URL=http://api:8000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DASHBOARD_CORS_ORIGIN=http://localhost:3000
# First admin user, created on first boot if no users exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Shared secret for service-to-service calls (orchestrator -> api). Not a JWT -
# machine clients send it as `X-Service-Token`. Generate the same way as SECRET_KEY.
INTERNAL_SERVICE_TOKEN=

# ---- Orchestrator service (OBSERVE -> REASON -> PLAN -> EXECUTE -> VERIFY) ----
ORCHESTRATOR_POLL_INTERVAL_SECONDS=5
ORCHESTRATOR_MAX_CONCURRENT_TARGETS=3
# Any action tagged with one of these categories blocks on a human approval
# in the dashboard before EXECUTE runs. See docs/ARCHITECTURE.md.
HITL_REQUIRED_CATEGORIES=admin_access,destructive_state_change,aggressive_payload,waf_bypass
HITL_APPROVAL_TIMEOUT_SECONDS=3600
RATE_LIMIT_DEFAULT_COOLDOWN_SECONDS=300
# Where CONFIRMED_*.md / raw evidence get written. Left unset here so the
# code default (/workspace/findings) applies, matching the ./workspace
# mount in docker-compose.yml. Only set this if running the orchestrator
# directly on the host (outside Docker) - point it at an absolute host path
# in that case, e.g. FINDINGS_DIR=C:/path/to/BugOrchestrator/workspace/findings
# (a *relative* path here resolves against the orchestrator process's cwd,
# not the repo root, so avoid one).
# FINDINGS_DIR=

# ---- Scan worker (Go) - wraps local recon/scan binaries ----
SCAN_WORKER_HOST=0.0.0.0
SCAN_WORKER_PORT=8090
SCAN_WORKER_INTERNAL_URL=http://scan-worker:8090
SCAN_WORKER_MAX_CONCURRENCY=5
SCAN_WORKER_DEFAULT_TIMEOUT_SECONDS=300
# Leave as bare binary names to resolve via PATH, or set an absolute path.
NMAP_BIN_PATH=nmap
HTTPX_BIN_PATH=httpx
NUCLEI_BIN_PATH=nuclei
NUCLEI_TEMPLATES_PATH=

# ---- Dashboard (Next.js, browser-visible - no secrets here) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# ---- External OSINT / recon integrations ----
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# ---- Burp Suite REST API (Burp Suite Professional "REST API" extension,
#      or Burp Suite Enterprise Edition API) ----
BURP_API_BASE_URL=http://localhost:1337
BURP_API_KEY=

# ---- Notifications ----
SLACK_WEBHOOK_URL=
NOTIFY_ON_CONFIRMED_FINDING=true
NOTIFY_ON_PENDING_APPROVAL=true
